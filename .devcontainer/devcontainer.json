{
  "name": "Dev Toil Reduction",
  "dockerComposeFile": [
    "docker-compose.yml"
  ],
  "service": "dev",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": true,
      "version": "latest"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-vscode.vscode-typescript-next",
        "ms-azuretools.vscode-docker",
        "ms-vscode.extension-test-runner",
        "vitest.explorer",
        "bierner.markdown-mermaid",
        "GitHub.vscode-pull-request-github"
      ],
      "settings": {
        "editor.inlineSuggest.experimentalInlineEditsEnabled": true,
        "github.copilot.chat.advanced.inlineEdits.enabled": true,
        "github.copilot.chat.agent.enabled": true,
        "github.copilot.chat.codesearch.enabled": true,
        "github.copilot.chat.generateTests.codeLens": true,
        "chat.agent.enabled": true,
        "chat.promptFiles": true,
        "git.enableSmartCommit": true,
        "github.copilot.chat.search.semanticTextResults": true,
        "github.copilot.chat.edits.temporalContext.enabled": true,
        "github.copilot.chat.completionContext.typescript.mode": "on",
        "github.copilot.chat.languageContext.typescript.enabled": true,
        "github.copilot.nextEditSuggestions.enabled": true,
        "github.copilot.chat.editor.temporalContext.enabled": true
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "git config --global --get-all safe.directory | grep -Fxq \"${containerWorkspaceFolder}\" || git config --global --add safe.directory \"${containerWorkspaceFolder}\"",
  "postAttachCommand": "if command -v gh &> /dev/null && [ ! -z \"$CODESPACE_NAME\" ]; then gh cs ports visibility 3000:public -c \"$CODESPACE_NAME\"; fi",
  "shutdownAction": "stopCompose",
  "forwardPorts": [3000, 5137],
  "portsAttributes": {
    "3000": {
      "label": "API",
      "onAutoForward": "notify"
    },
    "5137": {
      "label": "Frontend",
      "onAutoForward": "notify"
    }
  },
  "remoteEnv": {
    "NODE_ENV": "development"
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  }
}
